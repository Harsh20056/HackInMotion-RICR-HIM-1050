# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL 16 + PostGIS connection string
DATABASE_URL="postgresql://user:password@localhost:5432/samadhan?schema=public"

# JWT signing secrets — use long random strings in production
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cloudinary (signed uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed script credentials — required, no defaults baked into the seed itself
SEED_SUPER_ADMIN_EMAIL=superadmin@samadhan.gov.in
SEED_SUPER_ADMIN_PASSWORD=change_this_password

# Department admin credentials — one pair per department
SEED_WATER_SUPPLY_ADMIN_EMAIL=water_supply.admin@samadhan.gov.in
SEED_WATER_SUPPLY_ADMIN_PASSWORD=change_this_password

SEED_SANITATION_ADMIN_EMAIL=sanitation.admin@samadhan.gov.in
SEED_SANITATION_ADMIN_PASSWORD=change_this_password

SEED_ELECTRICITY_ADMIN_EMAIL=electricity.admin@samadhan.gov.in
SEED_ELECTRICITY_ADMIN_PASSWORD=change_this_password

SEED_ROADS_ADMIN_EMAIL=roads.admin@samadhan.gov.in
SEED_ROADS_ADMIN_PASSWORD=change_this_password

SEED_PARKS_ADMIN_EMAIL=parks.admin@samadhan.gov.in
SEED_PARKS_ADMIN_PASSWORD=change_this_password

SEED_BUILDINGS_ADMIN_EMAIL=buildings.admin@samadhan.gov.in
SEED_BUILDINGS_ADMIN_PASSWORD=change_this_password

SEED_CITIZEN_PASSWORD=change_this_password

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080

# Isolated database for the test suite. Tests refuse to run without it and
# refuse to run if it equals DATABASE_URL.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/samadhan_test?schema=public"

#AI
GROQ_API_KEY="your groq key"


# Email delivery via Resend. Without a key, email notifications are marked
# failed with a stated reason instead of silently dropped.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="Samadhan <onboarding@resend.dev>"

# Seeded users live on @samadhan.gov.in, a domain we don't own — Resend
# rejects sends to it without a verified custom domain. In non-production,
# set this to a real address you've verified with Resend and every
# outbound email redirects there (the intended recipient is still logged).
DEV_EMAIL_OVERRIDE=
